# Образец настроек. Скопируй в .env и впиши свои значения:
#   cp .env.example .env
# Сам .env в git не попадает (см. .gitignore). Этот файл — только названия, без настоящих значений.

# ---------- сайт (браузер) ----------
# Всё, что начинается с VITE_, попадает в код сайта и видно любому посетителю.
# Сюда только открытые адреса, НИКОГДА не ключи и не пароли.

# Адрес сервера совместной доски. Пусто — на localhost берётся ws://localhost:8787.
VITE_SERVER_URL=

# ---------- сервер ----------
# Эти значения читает только сервер, в браузер они не попадают.

# Порт сервера (хостинг обычно задаёт его сам).
PORT=8787

# База Turso — понадобится на следующих шагах. Токен — секрет, только в .env и в настройках хостинга.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
