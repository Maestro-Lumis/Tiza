# Зависимости и сборка
node_modules/
dist/
build/
.cache/

# Секреты и окружение: никогда не коммитим
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
secrets/
credentials*

# JSON-файлы не коммитим (данные, конфиги с ключами, сохранённые доски).
# Исключение: служебные файлы проекта без секретов.
*.json
!package.json
!package-lock.json

# Локальные данные досок
data/
*.db
*.sqlite
*.sqlite3

# Логи
*.log
npm-debug.log*

# IDE и система
.idea/
.vscode/
.DS_Store
